{
  "version": 2,
  "functions": {
    "GPP_EVM/api/index.js": {
      "includeFiles": "{GPP_EVM/views/**,GPP_EVM/public/**,GPP_EVM/scripts/**}"
    },
    "api/index.js": {
      "includeFiles": "{views/**,public/**,scripts/**,GPP_EVM/views/**,GPP_EVM/public/**,GPP_EVM/scripts/**}"
    }
  },
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/GPP_EVM/public/css/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/GPP_EVM/public/images/$1"
    },
    {
      "src": "/videos/(.*)",
      "dest": "/GPP_EVM/public/videos/$1"
    },
    {
      "src": "/scripts/(.*)",
      "dest": "/GPP_EVM/scripts/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/GPP_EVM/api/index.js"
    }
  ]
}