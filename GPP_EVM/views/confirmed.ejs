<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vote Confirmed</title>
  <link rel="stylesheet" href="/css/output.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hind+Madurai:wght@400;500;600;700&family=Roboto+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f5f0e7;
      --card: #ffffff;
      --panel: #b9dddd;
      --panel-dark: #769294;
      --paper: #fffcf3;
      --ink: #0f172a;
      --muted: #64748b;
      --success: #0f766e;
      --success-bright: #10b981;
      --shadow: rgba(15, 23, 42, 0.18);
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      min-height: 100%;
      background: var(--bg);
      font-family: 'Hind Madurai', sans-serif;
      color: var(--ink);
    }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.25rem;
      background: radial-gradient(circle at top, rgba(255,255,255,0.8), transparent 32%), linear-gradient(180deg, #f8f2eb 0%, #f1ebdf 100%);
    }

    .page-shell {
      width: min(100%, 56rem);
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .party-header {
      text-align: center;
      margin-bottom: 1.25rem;
      width: min(100%, 38rem);
    }

    .party-header .eyebrow {
      margin: 0;
      font-family: 'Roboto Mono', monospace;
      font-size: clamp(0.62rem, 1vw + 0.44rem, 0.76rem);
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #b45309;
      font-weight: 700;
    }

    .party-header h1 {
      margin: 0.8rem 0 0;
      font-size: clamp(2rem, 2.5vw + 1rem, 3rem);
      line-height: 1.12;
      font-weight: 700;
    }

    .vvpat-card {
      width: min(100%, 39rem);
      background: var(--card);
      border-radius: 1.7rem;
      padding: clamp(1rem, 2vw, 1.6rem);
      box-shadow: 0 24px 42px var(--shadow);
    }

    .machine-panel {
      border-radius: 1.5rem;
      border: 7px solid var(--panel-dark);
      background: var(--panel);
      padding: 1rem;
    }

    .machine-top {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      font-family: 'Roboto Mono', monospace;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #334155;
    }

    .paper-window {
      margin-top: 0.9rem;
      height: clamp(14rem, 33vw, 19rem);
      overflow: hidden;
      border-radius: 0.9rem;
      border: 8px solid #1f2937;
      background: #0f172a;
      padding: 1rem;
    }

    .slip {
      position: relative;
      min-height: 11rem;
      background: var(--paper);
      padding: 1.1rem 1.1rem 1rem;
      color: var(--ink);
      box-shadow: 0 18px 22px rgba(15, 23, 42, 0.12);
      border-radius: 0.4rem;
      overflow: hidden;
      transform-origin: top center;
    }

    .slip::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(255,255,255,0.3), rgba(148,163,184,0.08));
      pointer-events: none;
    }

    .slip > * {
      position: relative;
      z-index: 1;
    }

    .slip-label {
      font-family: 'Roboto Mono', monospace;
      font-size: 0.7rem;
      color: #64748b;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .party-box {
      margin: 1.2rem 0;
      padding: 0.9rem 0;
      border-top: 1px dashed rgba(51, 65, 85, 0.8);
      border-bottom: 1px dashed rgba(51, 65, 85, 0.8);
    }

    .party-box label {
      display: block;
      font-size: 0.8rem;
      color: #64748b;
      margin-bottom: 0.35rem;
    }

    .party-name {
      font-size: clamp(1.35rem, 2vw + 0.7rem, 2.15rem);
      font-weight: 700;
      line-height: 1.18;
      word-break: break-word;
    }

    .slip-footer {
      font-family: 'Roboto Mono', monospace;
      font-size: 0.68rem;
      color: #64748b;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .stamp {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      font-family: 'Roboto Mono', monospace;
      font-size: clamp(2.4rem, 5vw, 4rem);
      font-weight: 700;
      letter-spacing: 0.08em;
      color: rgba(16, 185, 129, 0.98);
      opacity: 1;
      text-shadow: 0 0 18px rgba(16, 185, 129, 0.25);
      user-select: none;
      pointer-events: none;
      transform: rotate(-20deg) scale(1);
      animation: stamp 0.55s linear both;
    }

    @keyframes stamp {
      0% {
        opacity: 0;
        transform: rotate(-20deg) scale(2.8);
        filter: blur(2px);
      }
      30% {
        opacity: 0.85;
      }
      100% {
        opacity: 1;
        transform: rotate(-20deg) scale(1);
        filter: blur(0);
      }
    }

    .confirmation-msg {
      margin-top: 1.2rem;
      text-align: center;
      color: #065f46;
      font-size: clamp(1.2rem, 1vw + 0.8rem, 1.7rem);
      font-weight: 800;
      letter-spacing: 0.03em;
    }

    .secondary-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 1.1rem;
      width: 100%;
      padding: 0.9rem 1rem;
      border-radius: 0.9rem;
      background: linear-gradient(180deg, #10b981 0%, #0f766e 100%);
      border: none;
      color: white;
      text-decoration: none;
      font-weight: 700;
      box-shadow: 0 10px 20px rgba(16, 185, 129, 0.25);
    }

    footer {
      margin-top: 1.2rem;
      width: 100%;
      text-align: center;
      font-size: 0.9rem;
      font-weight: 600;
      color: #334155;
      opacity: 0.9;
      letter-spacing: 0.02em;
    }

    @media (max-width: 640px) {
      body {
        padding: 0.8rem;
      }

      .vvpat-card {
        border-radius: 1.2rem;
        padding: 0.7rem;
      }

      .machine-panel {
        border-width: 5px;
        padding: 0.7rem;
      }

      .paper-window {
        border-width: 6px;
        padding: 0.7rem;
      }

      .secondary-action {
        width: 100%;
      }
    }

    @media (min-width: 641px) and (max-width: 1024px) {
      .vvpat-card {
        width: min(100%, 42rem);
      }
    }

    @media (min-width: 1280px) {
      .vvpat-card {
        width: min(100%, 42rem);
      }
    }
  </style>
</head>
<body>
  <main class="page-shell">
    <header class="party-header">
      <p class="eyebrow">Campus Democracy - VVPAT</p>
      <h1>Vote Recorded</h1>
    </header>

    <div class="vvpat-card">
      <section class="machine-panel">
        <div class="machine-top">
          <span>VVPAT Unit</span>
          <span>Secure</span>
        </div>

        <div class="paper-window">
          <article class="slip" aria-live="polite">
            <p class="slip-label">VVPAT Vote Slip</p>

            <div class="party-box">
              <label>Your selected party</label>
              <div class="party-name"><%= partyName %></div>
            </div>

            <p class="slip-footer">Printed for verification</p>
            <span class="stamp" aria-label="Vote stamped as voted">VOTED</span>
          </article>
        </div>
      </section>

      <p class="confirmation-msg">Your Vote is Considered</p>
      <a href="/" class="secondary-action">Back to Ballot</a>
    </div>
  </main>

  <footer>Made with passion by Sai N.</footer>
</body>
</html>
