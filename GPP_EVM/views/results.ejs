```ejs
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %> - Results</title>

  <link rel="stylesheet" href="/css/output.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Hind+Madurai:wght@400;500;600;700&family=Roboto+Mono:wght@500;700&display=swap"
    rel="stylesheet"
  >

  <style>
    html,
    body {
      min-height: 100%;
      margin: 0;
      background: #f4efe5;
    }

    body {
      font-family: 'Hind Madurai', sans-serif;
      color: #0f172a;
    }

    /* Main result container */
    .results-page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Graph animation */
    .bar {
      height: 0;
      transform-origin: bottom;
      animation: barRise 1.2s cubic-bezier(.22, 1, .36, 1) forwards;
    }

    @keyframes barRise {
      from {
        height: 0;
      }

      to {
        height: var(--bar-height);
      }
    }

    /* Winner popup */
    .winner-card {
      opacity: 0;
      transform: translateY(35px) scale(.92);
      animation:
        winnerAppear .75s cubic-bezier(.22, 1, .36, 1) 1.45s forwards,
        winnerGlow 1.8s ease-in-out 2.2s infinite alternate;
    }

    @keyframes winnerAppear {
      0% {
        opacity: 0;
        transform: translateY(35px) scale(.92);
      }

      70% {
        opacity: 1;
        transform: translateY(-5px) scale(1.03);
      }

      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes winnerGlow {
      from {
        box-shadow:
          0 10px 30px rgba(16, 185, 129, .18);
      }

      to {
        box-shadow:
          0 10px 40px rgba(16, 185, 129, .42);
      }
    }

    /* Winner crown animation */
    .winner-icon {
      animation: winnerIcon .8s cubic-bezier(.22, 1, .36, 1) 1.65s both;
    }

    @keyframes winnerIcon {
      0% {
        opacity: 0;
        transform: translateY(-15px) rotate(-12deg) scale(.5);
      }

      70% {
        transform: translateY(3px) rotate(5deg) scale(1.15);
      }

      100% {
        opacity: 1;
        transform: translateY(0) rotate(0) scale(1);
      }
    }

    /* Graph grid */
    .graph-grid {
      background-image:
        linear-gradient(
          to top,
          rgba(99, 120, 122, .18) 1px,
          transparent 1px
        );
      background-size: 100% 20%;
    }

    /* Mobile adjustments */
    @media (max-width: 640px) {
      .graph-area {
        height: 20rem !important;
      }

      .option-name {
        font-size: .7rem;
      }

      .count-label {
        font-size: .65rem;
      }
    }
  </style>
</head>

<body>

<div class="results-page">

  <!-- HEADER -->
  <header class="mx-auto w-full max-w-6xl px-4 pb-5 pt-8 sm:px-6 lg:px-8">

    <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">

      <div>
        <p class="font-mono text-xs font-bold tracking-[0.2em] text-orange-700">
          H2 DEMOCRACY - ODD 2026
        </p>

        <h1 class="mt-2 text-3xl font-bold leading-tight sm:text-4xl">
          <%= title %>
        </h1>

        <p class="mt-2 max-w-2xl text-base leading-relaxed text-slate-600">
          <%= description %>
        </p>
      </div>

      <a
        href="/dashboard"
        class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full border-2 border-[#63787a] bg-[#d1f1f1] px-5 py-2.5 font-semibold text-slate-800 shadow-sm transition hover:-translate-y-0.5 hover:bg-[#bfe5e6] focus:outline-none focus:ring-4 focus:ring-amber-400"
      >
        ← Dashboard
      </a>

    </div>

  </header>


  <!-- RESULTS MACHINE -->
  <main class="mx-auto w-full max-w-6xl flex-1 px-4 pb-10 sm:px-6 lg:px-8">

    <section
      class="rounded-[2.25rem] border-[7px] border-[#63787a] bg-[#a8cfd0] p-3 shadow-[0_22px_46px_rgba(48,65,68,.28)] sm:p-5"
      aria-label="Election results"
    >

      <!-- MACHINE DISPLAY -->
      <div class="overflow-hidden rounded-[1.45rem] border-2 border-[#84b6b8] bg-[#e6ffff]">

        <!-- DISPLAY HEADER -->
        <div class="flex items-center justify-between border-b border-[#9bcacc] bg-[#d1f1f1] px-5 py-3 font-mono text-xs font-bold tracking-wider text-slate-700">

          <span>RESULT DISPLAY</span>

          <span>
            ELECTION RESULTS
          </span>

        </div>


        <!-- GRAPH -->
        <div class="p-4 sm:p-7">

          <%
            const names = electionResults?.option_name || [];
            const counts = electionResults?.total_count || [];

            const maxCount = Math.max(...counts, 1);
            const totalVotes = counts.reduce(
              (sum, count) => sum + Number(count || 0),
              0
            );

            let winnerIndex = -1;

            if (counts.length > 0) {
              const highest = Math.max(...counts);

              if (highest > 0) {
                winnerIndex = counts.indexOf(highest);
              }
            }

            const winner =
              winnerIndex >= 0
                ? names[winnerIndex]
                : "No winner";

            const winnerVotes =
              winnerIndex >= 0
                ? Number(counts[winnerIndex])
                : 0;
          %>


          <!-- GRAPH TITLE -->
          <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">

            <div>
              <p class="font-mono text-xs font-bold tracking-widest text-slate-500">
                LIVE COUNT DISPLAY
              </p>

              <h2 class="mt-1 text-xl font-bold sm:text-2xl">
                Vote Distribution
              </h2>
            </div>

            <div class="rounded-full bg-emerald-100 px-4 py-2 text-sm font-bold text-emerald-800">
              <%= totalVotes %> Total Votes
            </div>

          </div>


          <!-- BAR GRAPH -->
          <div
            class="graph-area graph-grid relative flex h-[25rem] items-end gap-3 overflow-x-auto rounded-2xl border-2 border-[#9bcacc] bg-[#f8ffff] px-3 pb-0 pt-8 sm:gap-5 sm:px-8"
          >

            <% if (names.length === 0) { %>

              <div class="absolute inset-0 flex items-center justify-center">
                <div class="rounded-xl border border-orange-200 bg-orange-50 px-6 py-4 text-center font-semibold text-orange-800">
                  No voting data available.
                </div>
              </div>

            <% } else { %>

              <% names.forEach((name, index) => {

                const count = Number(counts[index] || 0);

                /*
                 * Keep a little space at the top of the graph.
                 * The tallest bar becomes 82% of graph height.
                 */
                const height =
                  count > 0
                    ? Math.max((count / maxCount) * 82, 4)
                    : 0;

                const isWinner = index === winnerIndex;

              %>

                <div class="relative flex h-full min-w-[5rem] flex-1 flex-col justify-end">

                  <!-- Vote count -->
                  <div
                    class="count-label mb-2 text-center font-mono text-xs font-bold text-slate-700"
                  >
                    <%= count %>
                  </div>


                  <!-- BAR -->
                  <div class="flex h-[82%] items-end justify-center">

                    <div
                      class="bar relative w-full max-w-[5rem] rounded-t-xl border-2 border-blue-900 bg-blue-700 shadow-[inset_0_2px_3px_rgba(255,255,255,.45),0_3px_5px_rgba(0,0,0,.18)]"
                      style="--bar-height: <%= height %>%; animation-delay: <%= index * 120 %>ms;"
                    >

                      <% if (isWinner) { %>

                        <div
                          class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-emerald-500 px-2 py-0.5 font-mono text-[9px] font-bold text-white shadow-md"
                        >
                          WIN
                        </div>

                      <% } %>

                    </div>

                  </div>


                  <!-- OPTION LABEL -->
                  <div
                    class="option-name mt-3 min-h-10 text-center font-bold leading-tight text-slate-700"
                    title="<%= name %>"
                  >
                    <%= name %>
                  </div>

                </div>

              <% }) %>

            <% } %>

          </div>


          <!-- GRAPH BASE -->
          <div class="mt-1 h-2 rounded-b-lg bg-[#63787a] shadow-inner"></div>


          <!-- WINNER -->
          <% if (winnerIndex >= 0) { %>

            <div class="winner-card mx-auto mt-7 max-w-2xl rounded-2xl border-2 border-emerald-700 bg-emerald-50 px-5 py-5 text-center">

              <div class="winner-icon mb-2 text-4xl">
                🏆
              </div>

              <p class="font-mono text-xs font-bold tracking-[0.2em] text-emerald-700">
                ELECTION WINNER
              </p>

              <div class="mt-1 text-2xl font-bold text-emerald-950 sm:text-3xl">
                <%= winner %>
              </div>

              <div class="mt-2 font-mono text-sm font-bold text-emerald-700">
                <%= winnerVotes %> VOTE<%= winnerVotes === 1 ? "" : "S" %>
              </div>

            </div>

          <% } else { %>

            <div class="winner-card mx-auto mt-7 max-w-2xl rounded-2xl border-2 border-orange-300 bg-orange-50 px-5 py-5 text-center">

              <div class="text-4xl">
                🗳️
              </div>

              <p class="mt-2 font-mono text-xs font-bold tracking-[0.2em] text-orange-700">
                RESULT STATUS
              </p>

              <div class="mt-1 text-xl font-bold text-orange-950">
                No votes have been recorded yet.
              </div>

            </div>

          <% } %>

        </div>


        <!-- STATUS FOOTER -->
        <div class="border-t border-[#9bcacc] bg-[#d1f1f1] px-4 py-3 text-center text-sm font-semibold text-slate-700">

          Results calculated from recorded votes.

        </div>

      </div>

    </section>

  </main>


  <!-- FOOTER -->
  <footer class="w-full px-4 pb-5 pt-2 text-center text-sm font-semibold text-slate-700">
    Made with passion by Sai N.
  </footer>

</div>


<script src="https://cdn.tailwindcss.com"></script>

</body>
</html>
```
