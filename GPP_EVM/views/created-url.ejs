<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Poll Created - GPP EVM</title>

    <link rel="stylesheet" href="/css/output.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Hind+Madurai:wght@400;500;600;700&family=Roboto+Mono:wght@500;700&display=swap"
        rel="stylesheet">

    <style>
        html,
        body {
            min-height: 100%;
            margin: 0;
            background: #f4efe5;
        }

        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }


        /*
    ==========================================================
    PAGE
    ==========================================================
    */

        .success-layout {
            width: 100%;
            max-width: 1280px;
        }

        .success-shell {
            width: 100%;
            max-width: 850px;
        }


        /*
    ==========================================================
    SUCCESS PANEL
    ==========================================================
    */

        .success-card {
            background: #e6ffff;

            box-shadow:
                0 24px 55px rgba(48, 65, 68, .24),
                0 3px 8px rgba(48, 65, 68, .10);
        }


        /*
    ==========================================================
    URL FIELD
    ==========================================================
    */

        .url-display {
            min-width: 0;
            overflow-wrap: anywhere;
            word-break: break-word;
        }


        /*
    ==========================================================
    MOBILE
    ==========================================================
    */

        @media (max-width: 767px) {

            main {
                padding-top: 1rem !important;
                padding-bottom: 1rem !important;
            }

            .success-shell {
                max-width: 100%;
            }

            .success-card {
                border-radius: 1.5rem !important;
            }

            .success-title {
                font-size: 2rem !important;
            }

            .action-button {
                width: 100%;
            }

        }


        /*
    ==========================================================
    SMALL PHONES / FLIP PHONES
    ==========================================================
    */

        @media (max-width: 360px) {

            .success-card {
                border-width: 4px !important;
            }

            .card-content {
                padding: 0.9rem !important;
            }

            .success-title {
                font-size: 1.65rem !important;
            }

            .success-subtitle {
                font-size: 0.8rem !important;
            }

            .url-display {
                font-size: 0.68rem !important;
            }

            .action-button {
                min-height: 3rem !important;
                font-size: 0.7rem !important;
            }

        }


        /*
    ==========================================================
    TABLET
    ==========================================================
    */

        @media (min-width: 768px) and (max-width: 1100px) {

            .success-shell {
                max-width: 760px;
            }

        }


        /*
    ==========================================================
    LARGE DESKTOP / TV
    ==========================================================
    */

        @media (min-width: 1600px) {

            .success-shell {
                max-width: 1000px;
            }

            .success-title {
                font-size: 3rem !important;
            }

            .url-display {
                font-size: 1rem;
            }

        }


        /*
    ==========================================================
    PREVENT OVERFLOW
    ==========================================================
    */

        @media (max-width: 420px) {

            body {
                overflow-x: hidden;
            }

        }
    </style>

</head>


<body class="min-h-screen bg-[#f4efe5] font-[Hind_Madurai] text-slate-900">


    <!-- ========================================================
       MAIN
       ======================================================== -->

    <main class="flex w-full flex-1 items-center justify-center px-4 py-8 sm:px-6 sm:py-10 lg:px-8">

        <div class="success-layout flex justify-center">


            <!-- ====================================================
           SUCCESS CARD
           ==================================================== -->

            <section class="success-shell success-card overflow-hidden rounded-[2rem] border-[7px] border-[#63787a]"
                aria-label="Poll created successfully">


                <!-- ==================================================
             TERMINAL HEADER
             ================================================== -->

                <div
                    class="flex items-center justify-between gap-3 border-b border-[#9bcacc] bg-[#d1f1f1] px-4 py-3 sm:px-6 sm:py-4">

                    <div class="min-w-0">

                        <p class="truncate font-mono text-[0.65rem] font-bold tracking-wider text-slate-700 sm:text-xs">
                            EVM CONFIGURATION TERMINAL
                        </p>

                        <p class="mt-0.5 text-[0.65rem] font-semibold text-slate-500 sm:text-xs">
                            BOOTH CREATION COMPLETE
                        </p>

                    </div>


                    <!-- READY -->

                    <div
                        class="flex shrink-0 items-center gap-2 rounded-full bg-emerald-100 px-3 py-1.5 text-[0.65rem] font-bold text-emerald-800 sm:text-xs">

                        <span class="h-2 w-2 rounded-full bg-emerald-600 shadow-[0_0_7px_rgba(16,185,129,.6)]"></span>

                        CREATED

                    </div>

                </div>


                <!-- ==================================================
             CONTENT
             ================================================== -->

                <div class="card-content p-4 sm:p-7 md:p-9">


                    <!-- =================================================
               SUCCESS MESSAGE
               ================================================= -->

                    <div class="text-center">

                        <!-- Success indicator -->

                        <div
                            class="mx-auto flex h-16 w-16 items-center justify-center rounded-full border-[3px] border-emerald-700 bg-emerald-100 shadow-[0_0_18px_rgba(16,185,129,.18)] sm:h-20 sm:w-20">

                            <span class="text-3xl font-bold text-emerald-700 sm:text-4xl" aria-hidden="true">
                                ✓
                            </span>

                        </div>


                        <p
                            class="mt-5 font-mono text-[0.65rem] font-bold tracking-[0.18em] text-emerald-700 sm:text-xs">
                            BALLOT GENERATED
                        </p>


                        <h1 class="success-title mt-2 text-2xl font-bold leading-tight sm:text-3xl">
                            Poll created successfully!
                        </h1>

                <!-- =================================================
                 START / END / STATUS INFORMATION
                 ================================================= -->

                                <div
                                    class="mx-auto mt-5 max-w-xl rounded-xl border border-[#9bcacc] bg-white px-4 py-4 text-left shadow-sm">

                                    <div class="grid gap-4 sm:grid-cols-3 sm:gap-0">

                                        <!-- START -->

                                        <div class="sm:pr-4">

                                            <p
                                                class="font-mono text-[0.6rem] font-bold uppercase tracking-wider text-slate-500">
                                                Starts at
                                            </p>

                                            <p class="mt-1 break-words text-sm font-bold text-slate-800 sm:text-base">
                                                <%= user.starts_at%>
                                            </p>

                                        </div>


                                        <!-- END -->

                                        <div
                                            class="border-t border-[#d5e5e5] pt-3 sm:border-l sm:border-t-0 sm:px-4 sm:pt-0">

                                            <p
                                                class="font-mono text-[0.6rem] font-bold uppercase tracking-wider text-slate-500">
                                                Ends at
                                            </p>

                                            <p class="mt-1 break-words text-sm font-bold text-slate-800 sm:text-base">
                                                <%= user.ends_at %>
                                            </p>

                                        </div>


                                        <!-- STATUS -->

                                        <div
                                            class="border-t border-[#d5e5e5] pt-3 sm:border-l sm:border-t-0 sm:pl-4 sm:pt-0">

                                            <p
                                                class="font-mono text-[0.6rem] font-bold uppercase tracking-wider text-slate-500">
                                                Status
                                            </p>

                                            <div class="mt-1 flex items-center gap-2">

                                                <span
                                                    class="h-2.5 w-2.5 shrink-0 rounded-full bg-emerald-500 shadow-[0_0_7px_rgba(16,185,129,.6)]"
                                                    aria-hidden="true"></span>

                                                <p class="break-words text-sm font-bold text-emerald-700 sm:text-base">
                                                    <%= user.status %>
                                                </p>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                                <!-- =================================================
               DIVIDER
               ================================================= -->

                                <div class="my-7 flex items-center gap-3">

                                    <span class="h-px flex-1 bg-[#9bcacc]"></span>

                                    <span class="font-mono text-[0.6rem] font-bold tracking-widest text-slate-500">
                                        LIVE BALLOT ADDRESS
                                    </span>

                                    <span class="h-px flex-1 bg-[#9bcacc]"></span>

                                </div>


                                <!-- =================================================
               ACTIVE URL
               ================================================= -->

                                <div class="rounded-2xl border-2 border-[#84b6b8] bg-[#d9f5f5] p-4 sm:p-5">

                                    <p
                                        class="font-mono text-[0.65rem] font-bold uppercase tracking-wider text-slate-600">
                                        Active on
                                    </p>


                                    <!-- URL -->

                                    <div
                                        class="mt-2 flex items-stretch overflow-hidden rounded-xl border-2 border-[#9bcacc] bg-white shadow-sm">

                                        <div id="voteUrl"
                                            class="url-display flex min-w-0 flex-1 items-center px-3 py-3 font-mono text-xs font-semibold text-slate-700 sm:px-4 sm:text-sm">
                                            https://e-votex-one.vercel.app/<%=
                                                user.electionCode %>
                                        </div>


                                        <!-- COPY BUTTON -->

                                        <button type="button" id="copyButton"
                                            class="shrink-0 border-l-2 border-[#9bcacc] bg-[#d1f1f1] px-4 font-mono text-xs font-bold text-slate-700 transition hover:bg-[#bfe4e4] focus:outline-none focus:ring-4 focus:ring-amber-400 active:bg-[#add9d9] sm:px-5"
                                            aria-label="Copy voting URL">

                                            <span id="copyText">
                                                COPY
                                            </span>

                                        </button>

                                    </div>


                                    <p id="copyStatus"
                                        class="mt-2 hidden text-center text-xs font-semibold text-emerald-700"
                                        aria-live="polite">
                                        Voting URL copied to clipboard.
                                    </p>

                                </div>


                                <!-- =================================================
               HAPPY MESSAGE
               ================================================= -->

                                <div
                                    class="mt-6 rounded-xl border border-[#d7cdbb] bg-[#fffaf0] px-5 py-5 text-center shadow-sm">

                                    <p class="text-sm font-semibold leading-relaxed text-slate-700 sm:text-base">
                                        <%= user.happy_message %>
                                    </p>

                                </div>


                                <!-- =================================================
               FINAL NOTE
               ================================================= -->

                                <div class="mt-5 flex items-start gap-3 rounded-lg bg-slate-50 px-4 py-3">

                                    <span class="mt-0.5 text-sm text-slate-500" aria-hidden="true">
                                        ℹ
                                    </span>

                                    <p class="text-xs leading-relaxed text-slate-500">
                                        Share this URL with the people who need to participate
                                        in your poll. Voting will only be available during the
                                        configured schedule.
                                    </p>

                                </div>

                            </div>


                            <!-- ==================================================
             TERMINAL FOOTER
             ================================================== -->

                            <div class="border-t border-[#9bcacc] bg-[#d1f1f1] px-4 py-3 text-center">

                                <p class="font-mono text-[0.6rem] font-bold tracking-wider text-slate-600 sm:text-xs">
                                    BALLOT CONFIGURATION UNIT • OPERATION COMPLETE
                                </p>

                            </div>

            </section>

        </div>

    </main>

    <!-- ========================================================
       COPY URL JAVASCRIPT
       ======================================================== -->

    <script>

        const copyButton =
            document.getElementById("copyButton");

        const copyText =
            document.getElementById("copyText");

        const copyStatus =
            document.getElementById("copyStatus");

        const voteUrl =
            document.getElementById("voteUrl");


        copyButton.addEventListener("click", async () => {

            /*
            Get the complete URL displayed in the element.
            */

            const url =
                voteUrl.textContent.trim();


            try {

                /*
                Modern Clipboard API
                */

                await navigator.clipboard.writeText(url);


                /*
                Change button state
                */

                copyText.textContent = "COPIED";

                copyStatus.classList.remove("hidden");


                /*
                Restore after 2 seconds
                */

                window.setTimeout(() => {

                    copyText.textContent = "COPY";

                    copyStatus.classList.add("hidden");

                }, 2000);


            } catch (error) {

                /*
                Fallback for browsers where
                Clipboard API is unavailable.
                */

                const temporaryInput =
                    document.createElement("textarea");

                temporaryInput.value = url;

                temporaryInput.style.position = "fixed";
                temporaryInput.style.opacity = "0";

                document.body.appendChild(temporaryInput);

                temporaryInput.focus();
                temporaryInput.select();


                try {

                    document.execCommand("copy");

                    copyText.textContent = "COPIED";

                    copyStatus.classList.remove("hidden");


                    window.setTimeout(() => {

                        copyText.textContent = "COPY";

                        copyStatus.classList.add("hidden");

                    }, 2000);

                } catch (fallbackError) {

                    copyText.textContent = "FAILED";

                }


                document.body.removeChild(temporaryInput);

            }

        });

    </script>


    <!-- Tailwind CDN -->

    <script src="https://cdn.tailwindcss.com"></script>

</body>

</html>